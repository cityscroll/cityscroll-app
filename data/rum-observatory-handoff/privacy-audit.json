{
  "schema": "cityscroll.rum.handoff.privacy_audit.v1",
  "intake": "POST /performance-events",
  "normalizer": "worker/src/performance_events.mjs",
  "public_projection_private_keys": [
    "operator_label",
    "owner_source_path",
    "architecture_container_ref",
    "definition",
    "reason"
  ],
  "forbidden_keys": [
    "account",
    "account_id",
    "ad_id",
    "advertising_id",
    "attribution",
    "correlation_id",
    "css_path",
    "css_selector",
    "device_id",
    "dom_path",
    "dom_text",
    "entries",
    "entity_id",
    "error",
    "exception",
    "geolocation",
    "hash",
    "href",
    "id",
    "interaction_target",
    "ip",
    "latitude",
    "longitude",
    "navigation_url",
    "notice_id",
    "parcel_id",
    "path",
    "pathname",
    "project_id",
    "query",
    "record_id",
    "referrer",
    "resource_url",
    "screen_height",
    "screen_width",
    "search",
    "search_term",
    "selector",
    "session_id",
    "subscription_id",
    "target",
    "text",
    "token",
    "url",
    "user_agent",
    "vendor_id",
    "visitor",
    "visitor_id"
  ],
  "rejection_cases": [
    { "name": "forbidden visitor id", "batch_extra": { "visitor_id": "abc" }, "reason": "forbidden_key" },
    { "name": "forbidden session id", "batch_extra": { "session_id": "s" }, "reason": "forbidden_key" },
    { "name": "forbidden url", "observation_extra": { "url": "https://cityscroll.org/notices/1" }, "reason": "forbidden_key" },
    { "name": "forbidden raw search", "observation_extra": { "search_term": "housing" }, "reason": "forbidden_key" },
    { "name": "forbidden selector", "observation_extra": { "css_selector": "#list .row" }, "reason": "forbidden_key" },
    { "name": "unknown batch key", "batch_extra": { "note": "not-forbidden" }, "reason": "unknown_key" },
    { "name": "unknown metric", "observation_override": { "metric_id": "speed_score" }, "reason": "unknown_metric" },
    { "name": "missing measurement is not a zero", "observation_override": { "state": "missing", "value": 0 }, "reason": "unsupported_schema" }
  ],
  "missingness_rule": "A numeric value, including 0, exists only for state=measured; every non-measurement state forbids value.",
  "public_private_boundary": [
    "Public HTML never receives Analytics Engine credentials, SQL, or operator labels.",
    "GET /admin/performance is ADMIN_KEY, Cache-Control private, no-store.",
    "Public /stats and /admin/stats remain usage/corpus surfaces and must not grow performance fields.",
    "Desk reads the private Worker contract only; it never queries Analytics Engine."
  ]
}
