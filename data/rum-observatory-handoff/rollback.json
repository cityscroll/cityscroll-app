{
  "schema": "cityscroll.rum.handoff.rollback.v1",
  "independent_switches": [
    {
      "id": "collector",
      "name": "Public collector contract collector.production_enabled",
      "where": "architecture/performance-observability.v1.json collector_contract.production_enabled",
      "off_value": false,
      "rebuild": "node tools/build_performance_observability.mjs"
    },
    {
      "id": "ingest",
      "name": "Worker RUM_INGEST_ENABLED",
      "where": "worker/wrangler.toml [vars] and [env.beta.vars]",
      "off_value": "false",
      "redeploy": "Worker deploy after setting the production var to false"
    }
  ],
  "rollback_proof": [
    "test/rum_collector.test.mjs",
    "worker/test/performance_events.test.mjs"
  ],
  "pilot_proof_when_present": [
    "test/rum_pilot_rollout.test.mjs",
    "worker/test/rum_pilot_rollout.test.mjs",
    "docs/rum-production-pilot.md"
  ],
  "invariants": [
    "Either switch alone stops new writes.",
    "Historical Analytics Engine rows remain queryable.",
    "Public navigation and /stats are unchanged.",
    "Disabling a switch is not data deletion, not a percentile rollback, and not merge enforcement."
  ]
}
