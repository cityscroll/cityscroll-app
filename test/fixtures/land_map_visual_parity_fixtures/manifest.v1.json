{
  "schema": "cityscroll.land-map-visual-parity-fixtures-manifest.v1",
  "card": "cityscroll-engineering/land-map-visual-parity-fixtures",
  "join": "exact_project_id",
  "anchor_specimen": {
    "project_id": "2025K0305",
    "why": "a multi-BBL rezoning: on the map, and never labeled an exact address"
  },
  "exact_precision_specimen": {
    "project_id": "2026R0127",
    "why": "an exact single-BBL centroid, contrasted against the anchor's lower precision"
  },
  "viewports": {
    "mobile": [320, 568],
    "narrow": [390, 844],
    "wide": [1440, 900]
  },
  "negative_rule": [
    "no viewport is ever passed to the Land filter as a bounds query",
    "parity is never asserted from a marker count alone; List and Map id sets are compared as sets",
    "an unmapped row is never hidden from a receipt or a count",
    "no fixture screenshot path or evidence field carries a local filesystem reference",
    "no fixture treats a visual read as a substitute for a canonical id, count, or precision label"
  ],
  "fixtures": [
    {
      "id": "default",
      "title": "Default population: mapped and unmapped together",
      "list_route": "/browse/zoning/",
      "map_route": "/browse/zoning/?view=map",
      "viewports": ["narrow", "wide"],
      "dependency_scenario": "healthy",
      "expects": {
        "total": 40,
        "has_mapped": true,
        "has_unmapped": true,
        "list_map_partition": true,
        "contains_ids": ["2025K0305", "2026R0127"],
        "marker_methods_labeled": true,
        "contains_precisions": ["exact", "anchor"],
        "axe": true
      }
    },
    {
      "id": "unmapped-honesty",
