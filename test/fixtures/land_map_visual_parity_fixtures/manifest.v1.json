      "map_route": "/browse/zoning/?status=all&stage=completed&view=map",
      "viewports": ["narrow", "wide"],
      "dependency_scenario": "healthy",
      "expects": {
        "mapped": 0,
        "total_at_least": 1,
        "list_map_partition": true,
        "unmapped_note_present": true,
        "axe": true
      }
    },
    {
      "id": "selected",
      "title": "Selecting the multi-BBL anchor reveals identity, method, and precision without leaving the map",
