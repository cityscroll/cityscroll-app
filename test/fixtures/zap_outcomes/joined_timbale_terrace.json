    {
      "type": "dispositions",
      "id": "cc550318-9a2c-ee11-9965-001dd8305eae",
      "attributes": {
        "dcp-publichearinglocation": "DREAM Charter School, 1991 Second Avenue, New York, NY 10029",
        "dcp-ispublichearingrequired": 717170000,
