    "doing-business-entities": {
      "id": "doing-business-entities",
      "source_contract_id": "doing-business-entities",
      "name": "Doing Business Search Entities",
      "kind": "socrata",
      "domain": "https://data.cityofnewyork.us",
      "dataset_id": "72mk-a8z7",
      "table_name": "doing_business_entities",
      "bulk_class": "BULK",
      "default_limit": 50,
      "wh02_full_export": true,
      "required_fields": [
        "organization_name"
