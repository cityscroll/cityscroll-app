{
  "schema_version": 1,
  "description": "CityScroll warehouse dataset registry (WH-01 scaffold). Full bulk land is WH-02.",
  "defaults": {
    "max_rows_default": 50,
    "max_rows_hard_cap": 10000,
    "require_ack_above": 1000,
    "one_job_at_a_time": true,
    "cpu_wrap": true,
    "headroom_gate": true
  },
  "datasets": {
    "ocp-recent-contract-awards": {
      "id": "ocp-recent-contract-awards",
      "source_contract_id": "ocp-recent-contract-awards",
