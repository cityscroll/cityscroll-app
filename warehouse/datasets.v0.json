      "kind": "socrata",
      "domain": "https://data.cityofnewyork.us",
      "dataset_id": "qyyg-4tf5",
      "table_name": "ocp_recent_contract_awards",
      "bulk_class": "BULK",
      "default_limit": 50,
      "wh02_full_export": true,
      "required_fields": [
        "request_id",
        "start_date",
        "agency_name",
        "type_of_notice_description",
        "pin",
        "contract_amount",
        "vendor_name"
      ],
      "notes": "WH-01 proof dataset. Tiny SODA $limit path only; full rows.csv is WH-02 under CPU caps."
    },
    "city-record": {
      "id": "city-record",
      "source_contract_id": "city-record",
