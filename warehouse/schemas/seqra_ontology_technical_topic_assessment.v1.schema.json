{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cityscroll.org/schemas/seqra_ontology_technical_topic_assessment.v1.schema.json",
  "title": "SEQRA/CEQR ontology: technical_topic_assessment",
  "description": "One observation of a technical topic's assessment state for a review, document version, and cutoff (environmental_review -> has_topic_assessment -> technical_topic_assessment). Absence of a mention is not screened_out.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_key",
    "review_key",
    "document_key",
    "technical_topic",
    "state",
    "observed_at",
    "available_to_public_at",
    "source_id",
    "source_record_id",
    "source_vintage",
    "evidence",
    "confidence",
    "rival_explanation",
    "suppression_rule"
  ],
  "properties": {
    "assessment_key": {
      "type": "string",
      "pattern": "^technical_topic_assessment:.+$"
    },
    "review_key": {
      "type": "string",
      "pattern": "^environmental_review:(ceqr|seqra):.+$"
    },
    "document_key": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^review_document:environmental_review:(ceqr|seqra):.+$"
    },
    "technical_topic": {
      "type": "string",
      "enum": [
        "land_use_zoning_public_policy",
        "socioeconomic_conditions",
        "community_facilities_services",
        "open_space",
        "shadows",
        "historic_cultural_resources",
        "urban_design_visual_resources",
        "natural_resources",
        "hazardous_materials",
        "water_sewer_infrastructure",
        "solid_waste_sanitation",
        "energy",
        "transportation",
        "air_quality",
        "greenhouse_gas_climate",
        "noise",
        "public_health",
        "neighborhood_character",
        "construction",
        "disadvantaged_communities",
        "alternatives"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "not_located",
        "screened_out",
        "detailed_analysis",
        "impact_identified",
        "mitigation_proposed",
        "mitigated",
        "unmitigated",
        "disputed_in_comments",
        "agency_response_complete",
        "supplementation_requested",
        "supplementation_denied"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "available_to_public_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_id": {
      "type": "string"
    },
    "source_record_id": {
      "type": "string"
    },
    "source_vintage": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rival_explanation": {
      "type": [
        "string",
        "null"
      ]
    },
    "suppression_rule": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
