{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cityscroll.org/schemas/seqra_ontology_mitigation_commitment.v1.schema.json",
  "title": "SEQRA/CEQR ontology: mitigation_commitment",
  "description": "One mitigation or monitoring commitment tied to a review (environmental_review -> has_mitigation -> mitigation_commitment).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commitment_key",
    "review_key",
    "technical_topic",
    "description",
    "status",
    "observed_at",
    "available_to_public_at",
    "source_id",
    "source_record_id",
    "source_vintage",
    "evidence",
    "confidence",
    "rival_explanation",
    "suppression_rule"
  ],
  "properties": {
    "commitment_key": {
      "type": "string",
      "pattern": "^mitigation_commitment:.+$"
    },
    "review_key": {
      "type": "string",
      "pattern": "^environmental_review:(ceqr|seqra):.+$"
    },
    "technical_topic": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "land_use_zoning_public_policy",
        "socioeconomic_conditions",
        "community_facilities_services",
        "open_space",
        "shadows",
        "historic_cultural_resources",
        "urban_design_visual_resources",
        "natural_resources",
        "hazardous_materials",
        "water_sewer_infrastructure",
        "solid_waste_sanitation",
        "energy",
        "transportation",
        "air_quality",
        "greenhouse_gas_climate",
        "noise",
        "public_health",
        "neighborhood_character",
        "construction",
        "disadvantaged_communities",
        "alternatives",
        null
      ]
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "adopted",
        "monitoring",
        "fulfilled",
        "unfulfilled",
        "unknown"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "available_to_public_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_id": {
      "type": "string"
    },
    "source_record_id": {
      "type": "string"
    },
    "source_vintage": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rival_explanation": {
      "type": [
        "string",
        "null"
      ]
    },
    "suppression_rule": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
