{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cityscroll.org/schemas/seqra_ontology_search_coverage.v1.schema.json",
  "title": "SEQRA/CEQR ontology: search_coverage",
  "description": "One bounded court-record search coverage assessment for a determination, graded A-U. A search miss under low coverage is never treated as proof no case was filed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverage_key",
    "determination_key",
    "systems_searched",
    "coverage_grade",
    "search_date",
    "observed_at",
    "source_id",
    "source_record_id"
  ],
  "properties": {
    "coverage_key": {
      "type": "string",
      "pattern": "^search_coverage:.+$"
    },
    "determination_key": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^determination:[a-z0-9_]+:[a-z0-9_]+:\\d{4}-\\d{2}-\\d{2}$"
    },
    "systems_searched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_grade": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "U"
      ]
    },
    "search_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_id": {
      "type": "string"
    },
    "source_record_id": {
      "type": "string"
    }
  }
}
