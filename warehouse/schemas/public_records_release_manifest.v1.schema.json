{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cityscroll.org/schemas/public_records_release_manifest.v1.schema.json",
  "title": "Public-records release capture manifest",
  "description": "File handoff contract for a record obtained through a public-records request (FOIL). The artifact path is relative to the manifest file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release_id", "source", "artifact", "gap_id"],
  "properties": {
    "schema": { "const": "cityscroll.public_records_release_manifest.v1" },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "source": { "$ref": "#/$defs/source" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "gap_id": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "body", "request_identifier", "received_date"],
      "properties": {
        "type": { "const": "public-records request (FOIL)" },
        "body": { "type": "string", "minLength": 1 },
        "request_identifier": { "type": "string", "minLength": 1 },
        "received_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.+-]{0,31}$"
        }
      }
    }
  }
}
