  {
    "request_id": "20260708018",
    "start_date": "2026-07-15T00:00:00.000",
    "end_date": "2026-07-15T00:00:00.000",
    "agency_name": "Board of Correction",
    "type_of_notice_description": "Notice",
    "short_title": "NOTICE OF REOPENING OF PUBLIC COMMENT PERIOD ON PROPOSED RULES",
    "section_name": "Agency Rules",
    "event_date": null,
    "additional_description_1": "<p style='margin-right:-30px; text-align:center'><span style='font-size:12pt'><span style='font-family:' times='' new='' roman',serif'=''><strong><u><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>Notice of Reopening of Public Comment Period on Proposed Rules</span></span></u></strong></span></span></p><p style='text-align:center'>\u00a0</p><p style='text-align:justify'><span style='font-size:12pt'><span style='font-family:' times='' new='' roman',serif'=''><strong><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>NOTICE IS HEREBY GIVEN </span></span></strong><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>that the Board of Correction is reopening the public comment period for the proposed rules concerning amendments to the Board\u001as Minimum Standards related to mental health and health care. These rule proposals were first published in the City Record on January 12, 2026.</span></span></span></span></p><p style='text-align:justify'>\u00a0</p><p style='text-align:justify'><span style='font-size:12pt'><span style='font-family:' times='' new='' roman',serif'=''><strong><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>How do I comment on the proposed rules? </span></span></strong><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>Anyone can comment on the proposed rules by:</span></span></span></span></p><p style='text-align:justify'>\u00a0</p><ul>\t<li style='text-align:justify'><span style='font-size:12pt'><span style='font-family:' times='' new='' roman',serif'=''><strong><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>Website.\u00a0 </span></span></strong><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>You can submit comments to BOC through the NYC rules website at http://rules.cityofnewyork.us.</span></span></span></span></li>\t<li style='text-align:justify'><span style='font-size:12pt'><span style='font-family:' times='' new='' roman',serif'=''><strong><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>Email.\u00a0 </span></span></strong><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>You can email comments to redacted@example.com.</span></span></span></span></li></ul><p style='text-align:justify'>\u00a0</p><p style='text-align:justify'><span style='font-size:12pt'><span style='font-family:' times='' new='' roman',serif'=''><strong><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>Is there a deadline to submit comments? </span></span></strong><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>Yes. You must submit any comments to the proposed rules on or before<strong> </strong>August 26, 2026.</span></span></span></span></p><p style='text-align:justify'>\u00a0</p><p style='text-align:justify'><span style='font-size:12pt'><span style='font-family:' times='' new='' roman',serif'=''><strong><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>Can I review the comments made on the proposed rules? </span></span></strong><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>You can review the comments made online on the proposed rules by going to the website at http://rules.cityofnewyork.us/. </span></span></span></span></p><p style='text-align:justify'><span style='font-size:12pt'><span style='font-family:' times='' new='' roman',serif'=''><span style='font-size:11.0pt'><span style='font-family:' arial',sans-serif'=''>All comments received by BOC on the proposed rules will be made available to the public online at https://www.nyc.gov/site/boc/meetings/20260210.page</span></span></span></span></p>"
  },
