# Agency constellation HTML (build/deploy artifact only).
# Built by tools/build_agency_constellation_documents.mjs during
# tools/build_cloudflare_pages.mjs — never commit per-agency pages.
# Keep site/agencies/index.html (directory listing) tracked.
site/agencies/*/index.html

# Community-board constellation HTML is a build/deploy artifact; the aggregate
# source directory and lookup remain tracked.
site/community-boards/*/index.html

