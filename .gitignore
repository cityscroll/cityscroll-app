.agents/
# Local browser performance results
test/performance/artifacts/
.artifacts/
.external-schedule-state/

# Cloudflare Wrangler local cache (never commit)
.wrangler/

# CityScroll warehouse bulk data (WH-01) — code/fixtures stay tracked; bulk never in git
warehouse/raw/**
!warehouse/raw/.gitkeep
# Public-records captures are deliberately committed with their provenance;
