{
  "schema": "cityscroll.cloudflare-native-builds.v1",
  "repository": "cityscroll/cityscroll-app",
  "source_control": "github",
  "required_production_boundaries": [
    {
      "id": "cloudflare-pages",
      "name": "Cloudflare Pages",
      "pipeline": "deploy-cloudflare-pages",
      "workflow": ".github/workflows/deploy-cloudflare-pages.yml"
    },
    {
      "id": "cloudflare-worker",
      "name": "Cloudflare Worker",
      "pipeline": "deploy-worker",
      "workflow": ".github/workflows/deploy-worker.yml"
    }
  ],
  "pages": {
    "project": "cityscroll",
    "release_control_plane": "github_actions",
    "automatic_deploy_workflow": ".github/workflows/deploy-cloudflare-pages.yml",
    "production_branch": "main",
    "root_directory": "/",
    "build_command": "if [ \"$CF_PAGES_BRANCH\" = \"main\" ]; then node tools/build_cloudflare_pages.mjs --site-dir _site --refresh-decision-outcomes; else node tools/build_cloudflare_pages.mjs --site-dir _site; fi",
    "build_output_directory": "_site",
    "preview_deployments": true,
    "path_includes": ["site/**", "tools/**", "test/**", "warehouse/**", "docs/**"],
    "native_git_integration_required": false
  },
  "worker": {
    "name": "cityscroll-worker",
    "root_directory": "worker",
    "production_branch": "main",
    "build_command": "../tools/install_worker_dependencies.sh",
    "deploy_command": "npx wrangler d1 migrations apply crol-notices --remote && npx wrangler deploy --var GIT_COMMIT_SHA:${WORKERS_CI_COMMIT_SHA} --var WRANGLER_ENV:production",
    "preview_deploy_command": "npx wrangler versions upload --var GIT_COMMIT_SHA:${WORKERS_CI_COMMIT_SHA} --var WRANGLER_ENV:preview",
    "path_includes": ["worker/**", "capabilities/**", "entity_resolution/**", "ontology/**", "site/**", "tools/**", "warehouse/**"],
    "manual_fallback_workflow": ".github/workflows/deploy-worker.yml"
  }
}
