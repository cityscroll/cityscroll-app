{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cityscroll.org/schemas/repository-control-plane-cutover-shard.v1.schema.json",
  "title": "CityScroll repository control-plane cutover input v1",
  "type": "object",
  "required": ["schema", "id", "owner", "card", "kind", "updated_at", "value"],
  "properties": {
    "schema": { "const": "cityscroll.repository-control-plane.cutover-shard.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "owner": { "type": "string", "minLength": 1 },
    "card": { "const": "cityscroll-repository-control-plane/rcp-05" },
    "kind": { "enum": ["migration", "constant"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "value": { "type": "object" }
  },
  "additionalProperties": false
}
