    {
      "id": "meetings-ida-widening",
      "url": "#meetings?when=upcoming&q=IDA",
      "feature": "meeting-result-widening",
      "description": "Show a recent IDA meeting when no upcoming meeting matches the search.",
      "expectations": {
        "visible": [
          {
            "selector": "#meetingsfeed .fcard",
            "text": "IDA"
          },
          {
            "selector": "#meetingsfeed .tag.closed",
            "text": "Past"
          }
        ],
        "notVisible": [
          {
            "selector": "#meetingsfeed .empty"
          },
          {
            "selector": "#meetingsfeed .loading"
          }
        ],
        "states": [
          {
            "selector": "#meetingswhen",
            "property": "value",
            "equals": "upcoming"
          }
        ],
        "banner": {
          "selector": "#meetingswidening .widening-note",
          "visible": true,
          "text": "Showing recent past meetings for \u201cIDA\u201d (none upcoming)."
        }
      }
    },
    {
      "id": "contracts-closing-this-week",
      "url": "#money?mode=open&closing=week",
      "feature": "contract-closing-preset",
