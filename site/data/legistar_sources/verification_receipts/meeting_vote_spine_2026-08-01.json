    "view_metrics": "metrics.meeting_vote_spine_completeness_rate",
    "ui": "site/index.html#meetingOutcomesHTML",
    "data_attrs": ["data-meeting-spine", "data-spine-stage", "data-spine-subject", "data-spine-fill"]
  },
  "verify": "node --test test/meeting_vote_spine.test.mjs test/contract/meeting_outcomes.test.mjs test/procurement_lifecycle_stitch.test.mjs",
  "capture": "python3 tools/capture_meeting_event_spine.py"
}
