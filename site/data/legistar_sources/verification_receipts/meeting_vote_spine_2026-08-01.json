    "meeting_vote_spine_completeness_rate": 1,
    "full_spine_rate": 1,
    "spine_count": 1,
    "stage_rates": {
      "agenda": 1,
      "matter": 1,
      "action": 1,
      "vote": 1,
      "attachment": 1
    }
  },
  "partial_control": {
    "description": "agenda + matter only (no action/vote/attachment)",
    "meeting_vote_spine_completeness_rate": 0.4
  },
  "empty_control": {
    "meeting_vote_spine_completeness_rate": 0,
    "spine_count": 0
  },
  "product_surface": {
    "read_model": "worker/src/lib/meeting_outcomes.mjs",
    "builders": ["buildMeetingVoteSpine", "buildMeetingVoteSpines", "measureMeetingVoteSpineCompleteness"],
