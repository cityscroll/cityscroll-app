{
  "metric": "meeting_vote_spine_completeness_rate",
  "measured_at": "2026-08-01",
  "definition": "Mean stage_fill over matter-linked spines. Each spine is one Council matter path: agenda → matter → action → vote → attachment (five stages). full_spine_rate is the share with all five stages matched.",
  "stages": ["agenda", "matter", "action", "vote", "attachment"],
  "fixture": {
