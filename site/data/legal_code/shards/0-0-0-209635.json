{"schema":"cityscroll.legal_code_shard.v1","corpus_id":"nyc-administrative-code","source_file":"0-0-0-209635.xml","source_url":"https://codelibrary.amlegal.com/codes/newyorkcity/latest/NYCadmin/0-0-0-1#0-0-0-209635","observed_at":"2026-08-24T08:25:03.900Z","document_content_hash":"sha256:517585bdfd28871aa0f6f27616ffe8373fdc975780ea6f3e96181876dc9f7971","rows":[{"schema":"cityscroll.code_provision.v1","id":"nyc-administrative-code:7-901","corpus_id":"nyc-administrative-code","citation":"§ 7-901","heading":"Compensation.","parent_id":"nyc-administrative-code:chapter:9","level":"section","status":"current","current_text":"The public administrators of the counties within the city shall receive as compensation ninety percent of the amount paid to the judges of the surrogate's court of the counties within the city.","source":{"url":"https://codelibrary.amlegal.com/codes/newyorkcity/latest/NYCadmin/0-0-0-4604","system":"american_legal_publishing","source_ref":"american_legal_publishing:admin-xml:0-0-0-209635.xml:0-0-0-4604","observed_at":"2026-08-24T08:25:03.900Z","content_hash":"sha256:c4a6addd29191e03d67131b47134a8eb5b2e99c95be1be9f7907553c6847094b","document_hash":"sha256:517585bdfd28871aa0f6f27616ffe8373fdc975780ea6f3e96181876dc9f7971"},"hierarchy":[{"level":"chapter","label":"Chapter 9: Public Administrators","id":"nyc-administrative-code:chapter:9"}]}]}
