{"schema":"cityscroll.legal_code_shard.v1","corpus_id":"nyc-administrative-code","source_file":"0-0-0-236854.xml","source_url":"https://codelibrary.amlegal.com/codes/newyorkcity/latest/NYCadmin/0-0-0-1#0-0-0-236854","observed_at":"2026-08-24T08:25:03.900Z","document_content_hash":"sha256:c12e27c16248164cf64f4fc09d899724f2882e48a524a6a553cbbe29a7beaa2d","rows":[{"schema":"cityscroll.code_provision.v1","id":"nyc-administrative-code:21-1003","corpus_id":"nyc-administrative-code","citation":"§ 21-1003","heading":"Surplus school supplies.","parent_id":"nyc-administrative-code:chapter:32","level":"section","status":"current","current_text":"The department shall create and maintain a website where schools may list surplus school supplies for the purpose of allowing such surplus supplies to be claimed for use by other schools. Such website shall not be available to the public.\n\n(L.L. 2023/074, 6/11/2023, eff. 9/9/2023)","source":{"url":"https://codelibrary.amlegal.com/codes/newyorkcity/latest/NYCadmin/0-0-0-224015","system":"american_legal_publishing","source_ref":"american_legal_publishing:admin-xml:0-0-0-236854.xml:0-0-0-224015","observed_at":"2026-08-24T08:25:03.900Z","content_hash":"sha256:4843e2c72bb6826446ac249730f6c6f31bea7f93da3a7ce0b827493c1c57688a","document_hash":"sha256:c12e27c16248164cf64f4fc09d899724f2882e48a524a6a553cbbe29a7beaa2d"},"hierarchy":[{"level":"chapter","label":"Chapter 32: Surplus School Supplies","id":"nyc-administrative-code:chapter:32"}]}]}
