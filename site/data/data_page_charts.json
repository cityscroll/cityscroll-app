  "query": {
    "sections": {
      "$select": "section_name,count(request_id) AS n",
      "$group": "section_name",
      "$order": "n DESC"
    },
    "volume": {
      "$select": "date_trunc_ym(start_date) AS m,count(request_id) AS n",
      "$where": "start_date >= '2025-08-02T00:00:00'",
      "$group": "m",
      "$order": "m ASC"
    },
    "procmix": {
      "$select": "type_of_notice_description AS t,count(request_id) AS n",
      "$where": "section_name='Procurement' AND start_date >= '2025-08-02T00:00:00'",
      "$group": "t",
      "$order": "n DESC"
    },
    "agencies": {
      "$select": "agency_name,sum(contract_amount) AS total",
      "$where": "type_of_notice_description='Award' AND contract_amount > 0 AND contract_amount < 10000000000 AND start_date >= '2025-08-02T00:00:00'",
      "$group": "agency_name",
      "$order": "total DESC",
      "$limit": "10"
    },
    "vendors": {
      "$select": "vendor_name,sum(contract_amount) AS total",
      "$where": "type_of_notice_description='Award' AND contract_amount > 0 AND contract_amount < 10000000000 AND start_date >= '2025-08-02T00:00:00' AND vendor_name IS NOT NULL",
      "$group": "vendor_name",
      "$order": "total DESC",
      "$limit": "10"
    }
  },
