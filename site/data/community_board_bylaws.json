      "rules": [
        {
          "topic": "officer_structure",
          "answer": "yes",
          "statement": "The board has a Chair, two Vice Chairs, Secretary, Assistant Secretary, Treasurer, and Assistant Treasurer.",
          "value": { "offices": ["Chair", "First Vice Chair", "Second Vice Chair", "Secretary", "Assistant Secretary", "Treasurer", "Assistant Treasurer"] },
          "source_locator": "page 2, Article II(A)"
        },
        {
          "topic": "standing_committee_rules",
          "answer": "yes",
          "statement": "Standing committees continue from year to year and board members are generally expected to serve on at least two.",
          "value": { "standing_committee_continuity": true, "expected_memberships": 2 },
          "source_locator": "page 10, Article VIII(A)-(B)"
        },
        {
          "topic": "committee_membership_eligibility",
          "answer": "yes",
          "statement": "The Chair appoints or reassigns board members to committees after consulting the respective committee chairs.",
          "value": { "appointing_authority": "Board Chair", "consultation": "committee chairs" },
          "source_locator": "page 10, Article VIII(B)"
        },
        {
          "topic": "public_committee_member_eligibility",
          "answer": "yes",
          "statement": "A person with a residence or significant interest in the community may be included on a committee even when they are not a board member, except on the Executive Committee.",
          "value": { "residence_or_interest_required": true, "executive_committee_excluded": true, "maximum_fraction": "one-third" },
          "source_locator": "page 10, Article VIII(D)"
        },
        {
          "topic": "public_committee_member_voting",
          "answer": "yes",
          "statement": "Public members may vote at meetings of the committee to which they have been appointed, but do not have a right to vote at Full Board business sessions.",
          "value": { "committee_vote": true, "full_board_vote": false },
          "source_locator": "pages 9-10, Article VII(A)(4) and Article VIII(D)"
        },
        {
          "topic": "voting_eligibility",
          "answer": "yes",
          "statement": "A board member may vote only on a committee to which that member has been appointed; public committee members have the committee vote stated in Article VIII(D).",
          "value": { "board_member_scope": "appointed committee", "public_member_scope": "appointed committee" },
          "source_locator": "page 10, Article VIII(C)-(D)"
        },
        {
          "topic": "quorum",
          "answer": "yes",
          "statement": "A majority of appointed board members constitutes a quorum for the Community Board.",
          "value": { "threshold": "majority", "subject": "appointed board members" },
          "source_locator": "page 8, Article VI(A)(1)"
        },
        {
          "topic": "public_participation",
          "answer": "yes",
          "statement": "Regular meetings include a public session, and the public may attend and speak under the stated meeting procedures.",
