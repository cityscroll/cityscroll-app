          "source_locator": "pages 8-9, Article VII(A)(3)-(4)"
        },
        {
          "topic": "committee_full_board_referral",
          "answer": "yes",
          "statement": "Committee reports and proposed resolutions are presented to the Full Board; committee action outside the regular cycle is expressly non-binding on the Board.",
