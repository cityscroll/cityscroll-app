{
  "schema": "cityscroll.cloudflare_os_code_mode_experiment_deployment.v1",
  "adapter": "cloudflare-os.typed-code-mode@1",
  "card": "code-mode-measurement",
  "runtime": "isolated Code Mode rehearsal",
  "upstream": {
    "starter": {
      "repository": "https://github.com/cloudflare/cloudflare-os-starter",
      "commit": "3d211477ad009e13a98d863d843e5c12a29ad02b"
    },
    "cloudflare_os": {
      "repository": "https://github.com/cloudflare/cloudflare-os",
      "commit": "e4b5cc65c4681ec72ff95e67a6dcd087fd1c4e04"
    },
    "gatekeeper": {
      "package": "packages/gatekeeper-mcp",
      "mode": "named-tools"
    },
    "code_mode": {
      "package": "@cloudflare/codemode",
      "version": "0.5.1",
      "pattern": "single_code_tool",
      "executor": "isolated-in-process-rehearsal",
      "dynamic_worker_loader": false
    }
  },
  "gadget": {
    "entrypoint": "src/sandbox.mjs",
    "model": {
      "id": "cs-08-frozen-plan-v1",
      "live": false,
      "provider": "none"
    },
    "bindings": [],
    "credentials": [],
    "ambient_internet": false
  },
  "grant": {
    "authority_class": "public_read",
    "capability_references": [
      "cited.passages.retrieve@1",
      "entity.dossier.get@1",
      "entity.relationships.get@1",
      "notice.search@1"
    ],
    "tools": [
      "get_entity_dossier",
      "get_entity_relationships",
      "search_notices",
      "retrieve_cited_passages"
    ],
    "write_tools": []
  },
  "experiment": {
    "kind": "isolated-reversible-ab",
    "baseline_arm": "ordinary-mcp",
    "treatment_arm": "typed-code-mode",
    "production_migration": false,
    "marketing_claim": false
  },
  "kill_switch": {
    "variable": "CITYSCROLL_CS08_ENABLED",
    "enabled_value": "true",
    "disabled_value": "false",
    "default": "false"
  },
  "rollback": {
    "route_removal": "disable the isolated Code Mode rehearsal and leave the CS-07 ordinary MCP proof in place",
    "deployment_removal": "delete the isolated Code Mode rehearsal by recorded deployment_id",
    "cityscroll_change": false
  }
}
