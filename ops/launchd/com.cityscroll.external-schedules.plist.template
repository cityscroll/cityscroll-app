<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cityscroll.external-schedules</string>
  <!-- launchd starts an agent with the system default PATH, which does not
       contain a user- or package-manager-installed Node. Looking the
       interpreter up by name exits 127 before any code runs, and the only
       symptom anywhere is the heartbeat the watchdog reports missing, so the
       installer resolves an absolute interpreter and writes it here. -->
  <key>ProgramArguments</key>
  <array>
    <string>__CITYSCROLL_NODE__</string>
    <string>__CITYSCROLL_ROOT__/tools/external_schedule_runner.mjs</string>
    <string>--due</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts this agent with no login shell, so every input the cycle
         needs is named here. The credential is read from a mode-0600 file
         rather than embedded, so no secret is written into this plist. -->
    <key>CROL_EXTERNAL_SCHEDULE_STATE_DIR</key>
    <string>__CROL_EXTERNAL_SCHEDULE_STATE_DIR__</string>
    <key>CITYSCROLL_ADMIN_KEY_FILE</key>
    <string>__CITYSCROLL_ADMIN_KEY_FILE__</string>
    <!-- The issue loop's delivery identity, read from a mode-0600 file the
         same way as the admin credential. Only the path appears here, and
         naming a path neither installs nor verifies the credential: the cycle
         reports delivery offline until it can read the file. -->
    <key>GH_TOKEN_FILE</key>
    <string>__GH_TOKEN_FILE__</string>
    <!-- The same delivery identity in its GitHub App form: an App installed on
         this repository alone, whose short-lived installation tokens the cycle
         mints for itself. Three mode-0600 files hold the App id, the
         installation id, and the signing key; only their paths appear here.
         Naming any of the three makes the App path authoritative for the whole
         cycle, so a half-installed App reports offline with its reason rather
         than delivering under the token file instead. Leave all three empty and
         the cycle uses GH_TOKEN_FILE exactly as before. -->
    <key>GH_APP_ID_FILE</key>
    <string>__GH_APP_ID_FILE__</string>
    <key>GH_APP_INSTALLATION_ID_FILE</key>
    <string>__GH_APP_INSTALLATION_ID_FILE__</string>
    <key>GH_APP_PRIVATE_KEY_FILE</key>
    <string>__GH_APP_PRIVATE_KEY_FILE__</string>
    <key>CITYSCROLL_SCHEDULER_HEARTBEAT_URL</key>
    <string>https://api.cityscroll.org/admin/reliability/scheduler</string>
    <!-- The bounded repair task the cycle runs for one leased repair item. It
         is operator configuration: the queue describes a failure and never
         names anything to execute, and the item reaches this command on stdin
         so nothing a queue record carries can reach a shell. The installer
         defaults it to a launcher that execs the resolved interpreter against
         this checkout's deterministic dispatcher, which selects a committed
         playbook, verifies the result, and exits 0 repaired / 2 judgment /
         1 failed. Left empty, the cycle publishes liveness, declares
         repair_dispatch false, and leases nothing. -->
    <key>CITYSCROLL_REPAIR_DISPATCH_COMMAND</key>
    <string>__CITYSCROLL_REPAIR_DISPATCH_COMMAND__</string>
  </dict>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__CROL_EXTERNAL_SCHEDULE_LOG_DIR__/runner.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__CROL_EXTERNAL_SCHEDULE_LOG_DIR__/runner.stderr.log</string>
</dict>
</plist>
