<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cityscroll.external-schedules</string>
  <!-- launchd starts an agent with the system default PATH, which does not
       contain a user- or package-manager-installed Node. Looking the
       interpreter up by name exits 127 before any code runs, and the only
       symptom anywhere is the heartbeat the watchdog reports missing, so the
       installer resolves an absolute interpreter and writes it here. -->
  <key>ProgramArguments</key>
  <array>
    <string>__CITYSCROLL_NODE__</string>
    <string>__CITYSCROLL_ROOT__/tools/external_schedule_runner.mjs</string>
    <string>--due</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts this agent with no login shell, so every input the cycle
         needs is named here. The credential is read from a mode-0600 file
         rather than embedded, so no secret is written into this plist. -->
    <key>CROL_EXTERNAL_SCHEDULE_STATE_DIR</key>
    <string>__CROL_EXTERNAL_SCHEDULE_STATE_DIR__</string>
    <key>CITYSCROLL_ADMIN_KEY_FILE</key>
    <string>__CITYSCROLL_ADMIN_KEY_FILE__</string>
    <key>CITYSCROLL_SCHEDULER_HEARTBEAT_URL</key>
    <string>https://api.cityscroll.org/admin/reliability/scheduler</string>
    <!-- The bounded debug/fix task the cycle runs for one leased repair item.
         It is operator configuration and provider-neutral: the queue describes
         a failure and never names anything to execute. Leave it empty and the
         cycle publishes liveness without leasing repair work. -->
    <key>CITYSCROLL_REPAIR_DISPATCH_COMMAND</key>
    <string>__CITYSCROLL_REPAIR_DISPATCH_COMMAND__</string>
  </dict>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__CROL_EXTERNAL_SCHEDULE_LOG_DIR__/runner.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__CROL_EXTERNAL_SCHEDULE_LOG_DIR__/runner.stderr.log</string>
</dict>
</plist>
