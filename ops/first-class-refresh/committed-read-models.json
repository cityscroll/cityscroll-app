{
  "schema": "cityscroll.committed_read_model_rebuild.v1",
  "purpose": "Bind scheduled first-class refreshes to explicit CI checks and freshness assertions in site and Worker tests. Commands run in dependency order; published_paths binds generated outputs to the publication step. Unavailable acquisitions retain their verified populations and produce visible findings. Review-only and warehouse-held gaps are reported separately.",
  "gate_workflow": ".github/workflows/ci.yml",
  "gate_family": "static-standards",
  "published_paths": [
    {
      "path": "site",
      "reason": "The published resident datasets and the read models served beside them."
    },
    {
      "path": "worker",
      "reason": "The served copies the request-time worker reads, including the keyword search index shards."
    },
    {
      "path": "warehouse/receipts",
      "reason": "Acquisition receipts travel with the populations they attest. Committing the data without them leaves a receipt describing an earlier pull beside the artifact it is supposed to prove."
    },
    {
      "path": "docs",
      "reason": "Several rebuild steps write a committed evidence document rather than a served artifact: the served-coverage census, the geography located-in audit, the data-source graph and the gap taxonomy. A refresh that regenerates one of these and does not stage it publishes the input without the evidence, and the gate that re-derives the document in check mode then fails on the refresh's own pull request."
    },
    {
      "path": "test/fixtures/agency_source_identity_compatibility/snapshot.v1.json",
      "reason": "The regenerated route identity snapshot is checked by the site unit family."
    },
    {
      "path": "artifacts/capability-spine/remote-mcp.json",
      "reason": "The pinned client interoperability receipt contains the refreshed provider semantic hashes."
    },
    {
      "path": "warehouse/fixtures/authority-native-procurement/institution_source_census.v1.json",
      "reason": "Only measured census fields move with refreshed populations; source review remains frozen."
    },
    {
      "path": "warehouse/fixtures/procurement-intent-radar/corpus_backtest.v1.json",
      "reason": "The intent-radar backtest gate re-derives this measured corpus artifact after procurement changes."
    },
    {
      "path": "warehouse/fixtures/procurement-intent-radar/corpus_coverage.v1.json",
      "reason": "The backtest coverage receipt must travel with the corpus measurement that produced it."
    }
  ],
