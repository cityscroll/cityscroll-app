#!/usr/bin/env bash
# Git pre-push hook: run the existing local preflight before any push leaves the machine.
# Install once per clone:
#   git config core.hooksPath tools/git-hooks
# Bypass only when you intentionally skip local gates (still must pass CI):
#   git push --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" ]]; then
  echo "pre-push: not inside a git work tree" >&2
  exit 1
fi
cd "$ROOT"

PREFLIGHT="$ROOT/tools/preflight-required-checks.sh"
if [[ ! -x "$PREFLIGHT" ]]; then
  if [[ -f "$PREFLIGHT" ]]; then
    chmod +x "$PREFLIGHT" || true
  else
    echo "pre-push: missing $PREFLIGHT" >&2
    exit 1
  fi
fi

# Detect whether any commit range being pushed touches site/** (fast tier vs --full).
# stdin lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
needs_full=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_sha:-}" ]] && continue
  # Delete ref: nothing to check.
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    # New branch: inspect all commits reachable from local_sha not on origin/main when known.
    range="$local_sha"
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      base="$(git merge-base origin/main "$local_sha" 2>/dev/null || true)"
      if [[ -n "$base" ]]; then
        range="${base}..${local_sha}"
      fi
    fi
  else
    range="${remote_sha}..${local_sha}"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -qE '^site/'; then
    needs_full=1
    break
  fi
done

args=()
# Reading-level is one of the three required contexts, so every pre-push run
# carries it. PREPUSH_EXTRA_ARGS remains available for additional local flags.
args+=(--with-reading-level)
if [[ "$needs_full" == "1" ]]; then
  args+=(--full)
  echo "pre-push: site/** changed in push range — running preflight with --full"
else
  echo "pre-push: running preflight (fast tier; site/** unchanged in push range)"
fi

# Honor PREPUSH_EXTRA_ARGS for additional local overrides.
# Under `set -u`, empty-array expansion of "${extra[@]}" fails on some bash builds —
# only append when PREPUSH_EXTRA_ARGS is non-empty.
if [[ -n "${PREPUSH_EXTRA_ARGS:-}" ]]; then
  # shellcheck disable=SC2206
  extra=( ${PREPUSH_EXTRA_ARGS} )
  args+=("${extra[@]}")
fi
# "${args[@]}" is unbound under set -u when the array is empty (bash 3.2+/set -u).
if ((${#args[@]})); then
  preflight_cmd=("$PREFLIGHT" "${args[@]}")
else
  preflight_cmd=("$PREFLIGHT")
fi
if ! "${preflight_cmd[@]}"; then
  echo "" >&2
  echo "pre-push: preflight failed — push rejected." >&2
  echo "  Fix locally, or re-run: make prepush" >&2
  echo "  Intentional bypass (CI must still pass): git push --no-verify" >&2
  exit 1
fi

echo "pre-push: preflight green"
exit 0
